{
  "name": "fairproof",
  "private": true,
  "version": "0.1.0",
  "description": "FairProof - A Zero Knowledge Procurement Integrity Protocol",
  "license": "Apache-2.0",
  "workspaces": [
    "packages/*",
    "apps/*",
    "services/*"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "doctor": "node scripts/doctor.mjs",
    "setup:ptau": "node scripts/setup-ptau.mjs",
    "setup:circuits": "npm run circuits:compile && npm run ceremony -- eligibility && npm run ceremony -- award && npm run ceremony -- winner_identity",
    "setup": "npm run setup:ptau && npm run crypto:build && npm run setup:circuits && npm run contracts:compile",
    "encoding:test": "npm run test --workspace @fairproof/crypto",
    "circuits:compile": "npm run compile --workspace @fairproof/circuits",
    "circuits:test": "npm run test --workspace @fairproof/circuits",
    "contracts:compile": "npm run compile --workspace @fairproof/contracts",
    "contracts:test": "npm run test --workspace @fairproof/contracts",
    "network:up": "UID=$(id -u) GID=$(id -g) docker compose -f infrastructure/besu/docker-compose.yml up -d",
    "network:down": "docker compose -f infrastructure/besu/docker-compose.yml down",
    "network:health": "node scripts/network-health.mjs",
    "test": "npm run crypto:build && npm run encoding:test && npm run contracts:test && npm run circuits:test",
    "network:setup": "node scripts/network-setup.mjs",
    "network:reset": "docker compose -f infrastructure/besu/docker-compose.yml down -v && node scripts/network-setup.mjs",
    "network:logs": "docker compose -f infrastructure/besu/docker-compose.yml logs -f --tail=100",
    "network:stop-validator": "node scripts/validator-control.mjs stop",
    "network:start-validator": "node scripts/validator-control.mjs start",
    "test:network": "node tests/integration/network-fault-tolerance.mjs",
    "test:deploy": "node tests/integration/deploy-smoke.mjs",
    "deploy": "node scripts/deploy.mjs",
    "test:e2e:lifecycle": "node tests/integration/e2e-tender-lifecycle.mjs",
    "ceremony": "node packages/circuits/scripts/ceremony.mjs",
    "ceremony:verify": "node packages/circuits/scripts/ceremony-verify.mjs",
    "crypto:build": "npm run build --workspace @fairproof/crypto",
    "fixtures:eligibility": "node packages/circuits/scripts/make-eligibility-fixture.mjs",
    "committee:deal": "node scripts/committee-ceremony.mjs deal",
    "committee:verify": "node scripts/committee-ceremony.mjs verify",
    "test:e2e:proof": "node tests/integration/e2e-eligibility-proof.mjs",
    "replicas:start": "node scripts/replica-control.mjs start",
    "replicas:stop": "node scripts/replica-control.mjs stop",
    "replicas:status": "node scripts/replica-control.mjs status",
    "test:storage": "node tests/integration/storage-quorum.mjs",
    "test:e2e:bid": "node tests/integration/e2e-sealed-bid.mjs",
    "test:e2e:opening": "node tests/integration/e2e-opening.mjs",
    "dashboard:dev": "npm run dev --workspace @fairproof/dashboard",
    "dashboard:build": "npm run build --workspace @fairproof/dashboard",
    "dashboard:sync": "node scripts/sync-dashboard-abis.mjs",
    "test:dashboard": "node tests/integration/dashboard-reads.mjs",
    "test:ui": "node scripts/smoke-dashboard.mjs",
    "test:certify": "node scripts/smoke-certify.mjs",
    "seed": "node scripts/seed-demo.mjs",
    "tender": "node scripts/publish-tender.mjs",
    "tender:complete": "node scripts/complete-tender.mjs",
    "evidence": "node scripts/export-evidence.mjs",
    "verify": "node packages/verifier/src/cli.mjs",
    "test:verifier": "node tests/integration/verifier-corruption.mjs"
  },
  "devDependencies": {
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  },
  "allowScripts": {
    "esbuild@0.21.5": true,
    "blake-hash@2.0.0": true,
    "keccak@3.0.4": true,
    "secp256k1@4.0.5": true
  }
}
