# ciphertext-store replica runtime (pids, logs, stored objects)
infrastructure/replica-run/

# dashboard generated artefacts (regenerated by `npm run dashboard:sync`)
apps/dashboard/src/generated/
apps/dashboard/public/circuits/
apps/dashboard/dist/

# Per-deployment seed material. Both are private in a real procurement and
# both are keyed to contract addresses that change on every deploy.
